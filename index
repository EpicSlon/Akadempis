  },
  {
    q: "Какой термин обозначает краткое описание содержания документа?",
    a: "Аннотация",
    wrong: ["Рецензия","Реферат","Предисловие","Введение"]
  },
  {
    q: "Какая часть статьи содержит гипотезу и цели исследования?",
    a: "Введение",
    wrong: ["Заключение","Методология","Обсуждение","Список литературы"]
  },
  {
    q: "Какая часть статьи содержит аналитический и статистический материал?",
    a: "Результаты (Results)",
    wrong: ["Введение","Аннотация","Заключение","Список литературы"]
  },
  {
