<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Академическое письмо — Квиз</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0a0f;
    --surface: #12121a;
    --card: #1a1a26;
    --border: #2a2a40;
    --accent: #e8c840;
    --accent2: #40e8c8;
    --text: #f0f0f8;
    --muted: #7070a0;
    --correct: #2ecc71;
    --wrong: #e74c3c;
    --radius: 12px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'IBM Plex Sans', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* Grid background */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(232,200,64,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(232,200,64,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 20px;
    position: relative;
    z-index: 1;
  }

  /* ── SCREENS ── */
  .screen { display: none; animation: fadeIn 0.4s ease; }
  .screen.active { display: block; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── START SCREEN ── */
  .start-wrap {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 40px 20px;
  }

  .logo-tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 24px;
    padding: 6px 16px;
    border: 1px solid var(--accent);
    display: inline-block;
  }

  h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 20px;
    background: linear-gradient(135deg, var(--text) 30%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 440px;
    line-height: 1.7;
    margin-bottom: 40px;
  }

  .stats-row {
    display: flex;
    gap: 32px;
    margin-bottom: 48px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .stat {
    text-align: center;
  }

  .stat-num {
    font-family: 'Playfair Display', serif;
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--accent);
    display: block;
  }

  .stat-label {
    font-size: 0.78rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
  }

  .btn-start {
    background: var(--accent);
    color: #0a0a0f;
    border: none;
    padding: 18px 52px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: var(--radius);
    transition: all 0.2s;
  }

  .btn-start:hover {
    background: #f5d840;
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(232,200,64,0.3);
  }

  /* ── QUIZ SCREEN ── */
  .quiz-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0 20px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 32px;
  }

  .q-counter {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .q-counter span {
    color: var(--accent);
    font-weight: 600;
    font-size: 1rem;
  }

  .score-badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    color: var(--accent2);
    padding: 4px 12px;
    border: 1px solid var(--accent2);
    border-radius: 20px;
  }

  /* Progress bar */
  .progress-track {
    height: 3px;
    background: var(--border);
    border-radius: 2px;
    margin-bottom: 32px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    border-radius: 2px;
    transition: width 0.4s ease;
  }

  .question-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 32px;
    margin-bottom: 24px;
  }

  .q-num-tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .question-text {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--text);
  }

  .options-grid {
    display: grid;
    gap: 12px;
  }

  .option-btn {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 20px;
    text-align: left;
    cursor: pointer;
    transition: all 0.18s;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    color: var(--text);
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .option-btn:hover:not(:disabled) {
    border-color: var(--accent);
    background: rgba(232,200,64,0.06);
    transform: translateX(4px);
  }

  .opt-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    background: rgba(232,200,64,0.1);
    width: 26px;
    height: 26px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .option-btn.correct {
    border-color: var(--correct);
    background: rgba(46,204,113,0.1);
  }

  .option-btn.correct .opt-label {
    background: rgba(46,204,113,0.2);
    color: var(--correct);
  }

  .option-btn.wrong {
    border-color: var(--wrong);
    background: rgba(231,76,60,0.1);
  }

  .option-btn.wrong .opt-label {
    background: rgba(231,76,60,0.2);
    color: var(--wrong);
  }

  .option-btn:disabled { cursor: default; }

  .feedback-bar {
    padding: 14px 20px;
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 16px;
    display: none;
    animation: slideUp 0.25s ease;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .feedback-bar.show { display: block; }
  .feedback-bar.ok { background: rgba(46,204,113,0.12); color: var(--correct); border: 1px solid rgba(46,204,113,0.3); }
  .feedback-bar.bad { background: rgba(231,76,60,0.12); color: var(--wrong); border: 1px solid rgba(231,76,60,0.3); }

  .btn-next {
    width: 100%;
    background: transparent;
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 16px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: var(--radius);
    transition: all 0.2s;
    display: none;
  }

  .btn-next:hover {
    background: var(--accent);
    color: #0a0a0f;
  }

  .btn-next.show { display: block; }

  /* ── RESULT SCREEN ── */
  .result-wrap {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 40px 20px;
  }

  .result-ring {
    width: 160px;
    height: 160px;
    margin: 0 auto 32px;
    position: relative;
  }

  .result-ring svg {
    transform: rotate(-90deg);
  }

  .ring-bg { fill: none; stroke: var(--border); stroke-width: 8; }
  .ring-fg { fill: none; stroke: var(--accent); stroke-width: 8; stroke-linecap: round; transition: stroke-dashoffset 1s ease; }

  .ring-text {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .ring-pct {
    font-family: 'Playfair Display', serif;
    font-size: 2.4rem;
    font-weight: 900;
    color: var(--accent);
  }

  .ring-sub {
    font-size: 0.72rem;
    letter-spacing: 2px;
    color: var(--muted);
    text-transform: uppercase;
  }

  .result-title {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .result-desc {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 40px;
    max-width: 380px;
    line-height: 1.7;
  }

  .result-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-restart {
    background: var(--accent);
    color: #0a0a0f;
    border: none;
    padding: 16px 40px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: var(--radius);
    transition: all 0.2s;
  }

  .btn-restart:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(232,200,64,0.3);
  }

  .btn-home {
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--border);
    padding: 16px 40px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.88rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: var(--radius);
    transition: all 0.2s;
  }

  .btn-home:hover { border-color: var(--muted); color: var(--text); }

  @media (max-width: 480px) {
    .question-card { padding: 20px; }
    .question-text { font-size: 1.1rem; }
    .stats-row { gap: 20px; }
  }
</style>
</head>
<body>

<!-- START -->
<div id="screen-start" class="screen active">
  <div class="start-wrap container">
    <div class="logo-tag">Академическое письмо</div>
    <h1>Тест на знание<br>научного письма</h1>
    <p class="subtitle">Проверь свои знания по академическому письму, методологии и научной этике. Каждый раунд — 40 случайных вопросов.</p>
    <div class="stats-row">
      <div class="stat"><span class="stat-num" id="total-q-count">160+</span><span class="stat-label">Вопросов</span></div>
      <div class="stat"><span class="stat-num">40</span><span class="stat-label">За раунд</span></div>
      <div class="stat"><span class="stat-num">5</span><span class="stat-label">Вариантов</span></div>
    </div>
    <button class="btn-start" onclick="startQuiz()">▶ Начать тест</button>
  </div>
</div>

<!-- QUIZ -->
<div id="screen-quiz" class="screen">
  <div class="container">
    <div class="quiz-header">
      <div class="q-counter">Вопрос <span id="q-num">1</span> / 40</div>
      <div class="score-badge">✓ <span id="score-display">0</span></div>
    </div>
    <div class="progress-track">
      <div class="progress-fill" id="progress-fill" style="width:0%"></div>
    </div>
    <div class="question-card">
      <div class="q-num-tag" id="q-tag">// вопрос 01</div>
      <div class="question-text" id="q-text">Загрузка...</div>
    </div>
    <div class="options-grid" id="options-grid"></div>
    <div class="feedback-bar" id="feedback-bar"></div>
    <button class="btn-next" id="btn-next" onclick="nextQuestion()">Следующий вопрос →</button>
  </div>
</div>

<!-- RESULT -->
<div id="screen-result" class="screen">
  <div class="result-wrap container">
    <div class="result-ring">
      <svg viewBox="0 0 160 160" width="160" height="160">
        <circle class="ring-bg" cx="80" cy="80" r="68"/>
        <circle class="ring-fg" id="ring-fg" cx="80" cy="80" r="68"
          stroke-dasharray="427" stroke-dashoffset="427"/>
      </svg>
      <div class="ring-text">
        <div class="ring-pct" id="result-pct">0%</div>
        <div class="ring-sub">результат</div>
      </div>
    </div>
    <div class="result-title" id="result-title">Молодец!</div>
    <div class="result-desc" id="result-desc"></div>
    <div class="result-actions">
      <button class="btn-restart" onclick="startQuiz()">↺ Новый раунд</button>
      <button class="btn-home" onclick="showStart()">На главную</button>
    </div>
  </div>
</div>

<script>
// ═══════════════════════════════════════════════════════════
// БАЗА ВОПРОСОВ
// ═══════════════════════════════════════════════════════════
const ALL_QUESTIONS = [
  {
    q: "Какой основной элемент делает текст эссе понятным и логичным?",
    a: "Последовательная аргументация и логические переходы между абзацами",
    wrong: ["Большое количество цитат из авторитетных источников","Использование сложных терминов и научного жаргона","Максимальный объём текста и подробность изложения","Яркое эмоциональное вступление с риторическими вопросами"]
  },
  {
    q: "Что означает «внутреннее смысловое единство» эссе?",
    a: "Все части текста подчинены одной главной идее и связаны между собой",
    wrong: ["Одинаковый объём вступления, основной части и заключения","Использование одного стиля оформления на протяжении всего текста","Написание эссе за один раз без перерывов","Отсутствие противоречий в оформлении ссылок и сносок"]
  },
  {
    q: "Какой стиль изложения рекомендуется для письменной научной работы?",
    a: "Нейтральный академический стиль без эмоциональной окраски",
    wrong: ["Разговорный стиль для лучшего восприятия читателем","Публицистический стиль с риторическими вопросами","Художественный стиль с образными сравнениями","Официально-деловой стиль с обилием клише"]
  },
  {
    q: "Что из нижеперечисленного является допустимым сокращением в тексте?",
    a: "Общепринятые аббревиатуры (напр., т.е., и др., см.)",
    wrong: ["Произвольные сокращения слов по усмотрению автора","Сокращение имён собственных до первой буквы","Замена любых длинных слов усечёнными формами","Использование интернет-сокращений типа «имхо», «инфа»"]
  },
  {
    q: "Что такое гипотеза?",
